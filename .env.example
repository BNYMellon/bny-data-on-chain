# JSON-RPC URLs for connecting to Ethereum networks.
# Obtain from a provider such as Alchemy, Infura, or QuickNode.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Optional: Private key for deploying contracts.
# NEVER commit your real private key. Use .env (which is git-ignored).
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
